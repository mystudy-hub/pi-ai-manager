{
  "name": "pi-ai-manager",
  "version": "3.1.3",
  "description": "Interactive AI Gateway & Model Manager extension for Pi Coding Agent",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "ai-gateway",
    "model-manager",
    "llm",
    "tui"
  ],
  "author": "mystudy-hub",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "docs/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <0.86.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "~7.0.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mystudy-hub/pi-ai-manager.git"
  },
  "bugs": {
    "url": "https://github.com/mystudy-hub/pi-ai-manager/issues"
  },
  "homepage": "https://github.com/mystudy-hub/pi-ai-manager#readme",
  "scripts": {
    "test": "node tests/test-reasoning.js && node tests/review-regression.cjs && node tests/tui-ux-regression.cjs && node tests/config-regression.cjs && node tests/security-regression.cjs && node tests/verify-integration.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  }
}
